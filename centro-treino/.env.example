# ---- Supabase ----
# URL e chave pública (anon) podem ir para o navegador; a RLS protege os dados.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Chave de serviço: SOMENTE no servidor. Ignora a RLS — nunca prefixar com NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# ---- App ----
# URL pública do app (usada nos links de convite enviados por e-mail)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_NOME_CENTRO="Movimento Aplicado"

# ---- Dados sensíveis (LGPD) ----
# Chave AES-256 em base64 (32 bytes) para cifrar histórico de lesões e observações de saúde.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder esta chave = perder os dados cifrados. Guarde em cofre de segredos.
DADOS_SENSIVEIS_CHAVE=

# ---- E-mail (Resend) ----
RESEND_API_KEY=
# Remetente verificado no Resend, ex.: "Centro de Treinamento <avaliacoes@seucentro.com.br>"
EMAIL_REMETENTE=

# ---- Identidade visual dos relatórios em PDF ----
# Cor principal (hex) do PDF. O logo vem de public/marca/logo.png; CENTRO_LOGO_URL substitui, se preenchido
CENTRO_COR=#054872
CENTRO_LOGO_URL=
